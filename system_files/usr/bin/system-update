#!/usr/bin/env bash
# One command to update everything: OS image (bootc), Flatpaks, brew.
set -euo pipefail

sudo bootc upgrade
flatpak update -y
if command -v brew &>/dev/null; then
    brew upgrade
    # `brew upgrade` only touches what is already installed, so a package newly
    # added to the dotfiles Brewfile would never land here (homelab#1635).
    # --no-upgrade keeps this to installing what is missing; upgrading is the
    # line above. Not fatal: a leftover fedora-remote Flatpak blocks its Flathub
    # copy (the fix is in the dotfiles README) and must not abort the run.
    if [[ -f "$HOME/src/dotfiles/Brewfile" ]]; then
        brew bundle install --no-upgrade --file "$HOME/src/dotfiles/Brewfile" \
            || echo "brew bundle reported failures (above) — continuing"
    fi
fi

# moshi-hook arrives with the image, so there is nothing to upgrade here, but a
# new release can want Claude Code hooks the dotfiles-stowed settings lack. Its
# own `status`/`doctor` always call the stowed hooks out of date (they compare
# command strings against the portable `command -v` guard, dotfiles#60) and
# offer `moshi-hook install`, which replaces the stow symlink: never run it on
# the real HOME. Instead install into a scratch HOME and compare event+matcher
# pairs (homelab#2094). This checks the running binary, so a release that bootc
# just staged is checked on the first run after the reboot.
moshi_hook_check() {
    local scratch missing pairs='.hooks // {} | to_entries[] | .key as $e | .value[]
        | select(any(.hooks[]; .command | test("moshi-hook"))) | "\($e) \(.matcher // "*")"'
    scratch=$(mktemp -d)
    trap 'rm -rf "$scratch"' RETURN
    HOME="$scratch" moshi-hook install --target claude </dev/null >/dev/null 2>&1 \
        && [[ -f "$scratch/.claude/settings.json" ]] || return 1
    missing=$(comm -23 <(jq -r "$pairs" "$scratch/.claude/settings.json" | sort -u) \
                       <(jq -r "$pairs" "$HOME/.claude/settings.json" | sort -u)) || return 1
    if [[ -n "$missing" ]]; then
        echo "WARNING: moshi-hook wants hooks absent from Claude settings (event matcher):"
        echo "$missing" | sed 's/^/  /'
        echo "  Add them via a dotfiles PR (portable command -v guard form);"
        echo "  do NOT run moshi-hook install — it breaks the stowed settings."
    fi
}
if command -v moshi-hook &>/dev/null && [[ -f "$HOME/.claude/settings.json" ]]; then
    moshi_hook_check || echo "WARNING: could not preview moshi-hook's wanted hooks in a scratch HOME; check by hand."
fi

# bootc's 3-way merge updates an /etc file only if the machine never changed
# it, and firewalld rewrites a whole zone file on any `firewall-cmd --permanent`
# edit. So a security change the image ships in /etc (the tailnet-only ssh
# zones, key-only sshd, homelab#2194) can silently not apply. Compare the
# running image's defaults (/usr/etc) with the live copies. Both trees are
# root-only, hence sudo; like the moshi-hook check this sees the running image,
# so a just-staged one is checked on the first run after the reboot.
etc_drift_check() {
    local f drift
    drift=$(sudo find /usr/etc/firewalld/zones /usr/etc/ssh/sshd_config.d -type f 2>/dev/null \
        | while read -r f; do sudo cmp -s "$f" "${f#/usr}" || echo "${f#/usr}"; done)
    if [[ -n "$drift" ]]; then
        echo "WARNING: these /etc files differ from the image's copy, so image changes to them do not apply:"
        echo "$drift" | sed 's/^/  /'
        echo "  Compare: sudo diff /usr<file> <file>; if nothing local is worth keeping:"
        echo "  sudo cp /usr<file> <file> (then sudo firewall-cmd --reload or systemctl reload sshd)."
    fi
}
etc_drift_check

echo "system-update done. If bootc staged a new image, reboot to activate it."
